# dev 模式配置模板
#
# 用法：
#   1. 复制为 dev.yaml：cp dev.yaml.tmp dev.yaml（dev.yaml 已被 gitignore，不入库）
#   2. 修改下面的值
#   3. make dev 启动（debug 构建，从本文件读取环境变量）
#
# 未设置的项使用代码内默认值（完整说明见 docs/development.md §4 配置表）。
# 注意：值不要包含空格。

# ---- 模型 ----

# 嵌入后端：gguf（llama.cpp + bge，默认，向后兼容）| onnx（ort CPU + granite）
# 两个后端的维度随模型派生（bge=512 / granite=384）；切换后端后旧索引维度
# 不匹配会启动报错，需换回或清空数据目录重建
RAG_BACKEND: gguf

# bge-small-zh-v1.5 Q8_0 GGUF 模型文件路径（~25MB，RAG_BACKEND=gguf 时使用）
RAG_MODEL_PATH: models/bge-small-zh-v1.5-q8_0.gguf

# granite-embedding-97m-multilingual-r2 ONNX（int8 量化 ~98MB）与分词器路径
# （RAG_BACKEND=onnx 时使用；make download-onnx 下载到 models/granite/）
RAG_ONNX_MODEL_PATH: models/granite/model.onnx
RAG_ONNX_TOKENIZER_PATH: models/granite/tokenizer.json

# ---- 存储 ----

# 数据目录：存放 index.tvim（压缩向量）与 tags.bin（映射+原始向量），备份时整体复制
RAG_DATA_DIR: data

# ---- HTTP 服务 ----

# 监听地址。生产环境如需外部访问，Docker 内应设为 0.0.0.0；
# 本地调试保持 127.0.0.1 即可（无认证，勿直接暴露公网）
RAG_HOST: 127.0.0.1

# 监听端口
RAG_PORT: 3000

# ---- 推理 ----

# llama.cpp 推理线程数（阶段 0 实测：8 核 CPU 上 4 最优，线程更多反而抢内存带宽）
RAG_N_THREADS: 4

# 上下文长度（gguf: bge-v1.5 上限 512；onnx: 单条文本 token 截断上限）
RAG_N_CTX: 512

# ---- 向量索引 ----

# turbovec 量化位宽（可选 2/3/4，4 精度最高）
# 注意：嵌入维度（RAG_DIM）已移除——维度由加载的模型实时派生
# （bge=512 / granite=384），与配置解耦
RAG_BIT_WIDTH: 4

# ---- 服务端分块 ----

# 单块最大字符数（中文 1 字 ≈ 1 token，260 ≈ 256 token；长文自动切块）
RAG_MAX_CHUNK_CHARS: 260

# 相邻块重叠字符数（≈ 50 token，避免切点切断语义）
RAG_OVERLAP_CHARS: 50

# ---- 存储行为 ----

# 是否在 tags.bin 持久化原始归一化向量（true=index.tvim 损坏时可自愈重建；
# false=省内存 ~2KB/块，损坏后需 Agent 重推全文）
RAG_STORE_RAW_VECTORS: true

# ---- 查询优化 ----

# 查询 embedding LRU 缓存条数（相同 q 重复查询免推理，命中率不足时调大）
RAG_LRU_CAPACITY: 1024
