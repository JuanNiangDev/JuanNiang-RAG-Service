# docker-compose 环境模板
#
# 用法：
#   1. 复制为 .env：cp .env.example .env（.env 已被 gitignore，不入库）
#   2. 修改下面的值
#   3. docker compose up -d --build
#
# compose 会自动读取本文件做变量替换；所有项都有默认值，全部删除也能跑。

# ---- 端口 ----

# 宿主监听端口（容器内固定 3000）
RAG_HTTP_PORT=3000

# ---- 模型 ----

# 模型目录（宿主路径，只读挂载到容器 /app/models；相对本文件所在目录）
MODEL_DIR=../../models

# 嵌入后端（gguf=llama.cpp+bge，默认；onnx=ort CPU+granite，384 维）
RAG_BACKEND=gguf

# 模型文件名（容器内完整路径 = /app/models/<此值>；RAG_BACKEND=gguf 时使用）
RAG_MODEL_FILE=bge-small-zh-v1.5-q8_0.gguf

# granite ONNX 路径（RAG_BACKEND=onnx 时使用；make download-onnx 下载到 models/granite/）
RAG_ONNX_MODEL_PATH=/app/models/granite/model.onnx
RAG_ONNX_TOKENIZER_PATH=/app/models/granite/tokenizer.json

# ---- 推理 ----

# llama.cpp 推理线程数（实测 8 核 CPU 上 4 最优）
RAG_N_THREADS=4

# 上下文长度（bge 上限 512）
RAG_N_CTX=512

# ---- 存储 ----

# 是否存原始向量（true=index.tvim 损坏可自愈重建；false=省内存 ~2KB/块）
RAG_STORE_RAW_VECTORS=true

# ---- 查询优化 ----

# 查询 embedding LRU 缓存条数（相同 q 重复查询免推理）
RAG_LRU_CAPACITY=1024

# ---- 分块 ----

# 单块最大字符数（≈256 token）
RAG_MAX_CHUNK_CHARS=260

# 相邻块重叠字符数（≈50 token）
RAG_OVERLAP_CHARS=50
